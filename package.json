{
  "name": "fitblueprint",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "build:chatgpt": "tsc --noEmit -p tsconfig.chatgpt.json && vite build --config vite.chatgpt.config.ts",
    "test:chatgpt": "vitest run --config vite.chatgpt.config.ts",
    "start": "node server/index.mjs",
    "test:server": "vitest run --config vite.server.config.ts"
  },
  "dependencies": {
    "@neon/auth": "^0.8.2",
    "express": "^5.3.0",
    "jose": "^6.2.17",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
