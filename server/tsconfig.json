{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "jsx": "react-jsx"
  },
  "include": ["src/**/*.ts", "../src/lib/**/*.ts", "../src/i18n/**/*.ts", "../src/state/storage.ts"],
  "exclude": ["../src/lib/cloud/supabase.ts", "../src/lib/__tests__/**"]
}
